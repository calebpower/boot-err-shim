#!/bin/sh
#
# boot-err-shim: press 'Y' at the PERC flash-failure prompt so the host boots.
#
# PROVIDE: boot_err_shim
# REQUIRE: LOGIN NETWORKING syslogd
# KEYWORD: shutdown
#
# Add the following to /etc/rc.conf to enable:
#
#   boot_err_shim_enable="YES"
#
# Optional:
#
#   boot_err_shim_config="/usr/local/etc/boot-err-shim.conf"
#   boot_err_shim_user="boot-err-shim"
#   boot_err_shim_flags=""            # e.g. --no-act

. /etc/rc.subr

name="boot_err_shim"
rcvar="boot_err_shim_enable"

load_rc_config $name

: ${boot_err_shim_enable:="NO"}
: ${boot_err_shim_config:="/usr/local/etc/boot-err-shim.conf"}
: ${boot_err_shim_user:="boot-err-shim"}
: ${boot_err_shim_group:="${boot_err_shim_user}"}
: ${boot_err_shim_state:="/var/db/boot-err-shim"}
: ${boot_err_shim_flags:=""}

# The pidfile gets a directory of its own rather than sitting in /var/run.
#
# daemon(8) drops to ${boot_err_shim_user} before it opens the -P file, and
# /var/run is root-owned 0755, so writing there fails with
# "ppid file: Permission denied" -- from daemon(8), which calls the -P file
# the ppid file, and with nothing in the message tying it to this service.
#
# start_precmd creates the directory owned by the service user on every
# start, because /var/run does not survive a reboot.
piddir="/var/run/${name}"
pidfile="${piddir}/${name}.pid"
shim="/usr/local/sbin/boot-err-shim"

# rc(8) runs with PATH=/sbin:/bin:/usr/sbin:/usr/bin, which does not include
# /usr/local/bin -- where FreeBSD keeps python3. The shim is a zipapp, so its
# shebang has to resolve, and a bundle built with `#!/usr/bin/env python3`
# fails here with "env: python3: No such file or directory" while working
# perfectly from an interactive shell.
#
# `make bundle` bakes an absolute interpreter path for this reason, so this is
# the second line of defence: it keeps a bundle copied from another machine
# working, and ping(8) and daemon(8) are found either way.
PATH="${PATH}:/usr/local/sbin:/usr/local/bin"
export PATH

# procname must name whatever owns the pid in $pidfile, and with daemon -P
# that is daemon(8) itself, not the shim. Two reasons not to point it at the
# shim: the pid belongs to the supervisor, and the shim is a zipapp with a
# `#!/usr/bin/env python3` line, so its process is python3 rather than
# anything matching the installed path.
#
# -t is deliberately not passed either. It rewrites the supervisor's process
# title, which is exactly the string rc.subr matches against here.
procname="/usr/sbin/daemon"

# daemon(8) supervises: -r restarts the program if it exits, -f sends its
# output to /dev/null, and -u drops privilege. The daemon needs none: ping(8)
# is setuid and VNC is an ordinary TCP connection.
#
# Output goes to /dev/null rather than to syslog because the program has its
# own syslog handler and would otherwise appear twice in the log. Anything
# that would be lost that way -- a bad config, an unreadable calibration --
# is caught by start_precmd below, before the fork, where the operator can
# still see it.
command="/usr/sbin/daemon"
command_args="-r -f -P ${pidfile} -u ${boot_err_shim_user} \
    ${shim} run -c ${boot_err_shim_config} ${boot_err_shim_flags}"

start_precmd="${name}_precmd"
stop_postcmd="${name}_postcmd"

boot_err_shim_precmd()
{
	if [ ! -f "${boot_err_shim_config}" ]; then
		err 1 "${boot_err_shim_config} does not exist. Copy" \
		    "${boot_err_shim_config}.sample and edit it."
	fi

	# Does the shim's shebang actually resolve?
	#
	# Checked explicitly because the failure is otherwise a bare
	# "env: python3: No such file or directory" with nothing naming the
	# program, the interpreter or the reason -- and it only happens under
	# rc(8), so it looks like the service is broken when the very same
	# command works by hand.
	_firstline=$(head -1 "${shim}" 2>/dev/null)
	case "${_firstline}" in
	'#!'*)
		;;
	*)
		# No shebang at all. The bundle was built by a make that silently
		# expanded the interpreter to nothing, and what follows is ZIP
		# header bytes -- reporting those as "the interpreter" is how this
		# check first read the situation, which helped nobody.
		err 1 "${shim} has no #! line, so it cannot be executed at all." \
		    "The bundle was built with a broken toolchain. Rebuild on this" \
		    "host with: make install-freebsd"
		;;
	esac

	_shebang=${_firstline#\#!}
	_interp=${_shebang%% *}
	if [ "${_interp}" = "/usr/bin/env" ]; then
		_wanted=${_shebang#* }
		if ! command -v "${_wanted}" > /dev/null 2>&1; then
			err 1 "${shim} asks for '${_wanted}' via env, and it is not on" \
			    "rc's PATH (${PATH}). Rebuild on this host with: make" \
			    "install-freebsd -- which bakes an absolute interpreter" \
			    "path -- or pass INTERPRETER=/usr/local/bin/python3."
		fi
	elif [ -n "${_interp}" ] && [ ! -x "${_interp}" ]; then
		err 1 "${shim} was built for interpreter ${_interp}, which is not" \
		    "executable on this host. Rebuild here with: make install-freebsd"
	fi

	if ! pw usershow "${boot_err_shim_user}" > /dev/null 2>&1; then
		err 1 "the service user ${boot_err_shim_user} does not exist. Run:" \
		    "pw useradd ${boot_err_shim_user} -d /nonexistent" \
		    "-s /usr/sbin/nologin"
	fi

	# Somewhere daemon(8) can write its pidfile after dropping privilege.
	# Recreated every start: /var/run is cleared at boot.
	if ! install -d -o "${boot_err_shim_user}" -g "${boot_err_shim_group}" \
	    -m 0755 "${piddir}"; then
		err 1 "cannot create ${piddir} owned by" \
		    "${boot_err_shim_user}:${boot_err_shim_group}"
	fi

	# Can the service user actually read the config?
	#
	# Checked by inspecting ownership rather than by becoming the user.
	# `su -m ${user} -c ...` runs the command through the *target* account's
	# shell, and a service account's shell is /usr/sbin/nologin, so that
	# refuses -- and the refusal is indistinguishable from a bad config,
	# which is what this used to report. Wrong diagnosis, wrong fix, wasted
	# evening.
	_owner=$(stat -f '%Su' "${boot_err_shim_config}")
	_group=$(stat -f '%Sg' "${boot_err_shim_config}")
	_mode=$(stat -f '%Lp' "${boot_err_shim_config}")
	_readable=no

	case "${_mode}" in
	*[4567]) _readable=yes ;;                      # world-readable
	esac
	if [ "${_owner}" = "${boot_err_shim_user}" ]; then
		case "${_mode}" in
		[4567]*) _readable=yes ;;                  # owner-readable
		esac
	fi
	if id -Gn "${boot_err_shim_user}" 2>/dev/null | tr ' ' '\n' \
	    | grep -qx "${_group}"; then
		case "${_mode}" in
		?[4567]*) _readable=yes ;;                 # group-readable
		esac
	fi

	if [ "${_readable}" != yes ]; then
		err 1 "${boot_err_shim_config} (owner ${_owner}:${_group}," \
		    "mode ${_mode}) cannot be read by ${boot_err_shim_user}." \
		    "Run: chown root:${boot_err_shim_user}" \
		    "${boot_err_shim_config} && chmod 640" \
		    "${boot_err_shim_config}"
	fi

	# Validated in the foreground, so a mistake reaches the person running
	# `service start` rather than a forked process whose output goes to
	# /dev/null. Run as root, which can always read the file -- readability
	# by the service user is the separate check above, and it gives a far
	# more specific error than "invalid config" would.
	if ! "${shim}" check-config -c "${boot_err_shim_config}" > /dev/null; then
		err 1 "${boot_err_shim_config} is not valid. Run:" \
		    "${shim} check-config -c ${boot_err_shim_config}"
	fi

	# If a log file is configured, the service user has to be able to write
	# it -- checked here because after the fork daemon(8) sends the very
	# error that would explain this to /dev/null, and daemon -r then restarts
	# the process in a loop while the log the operator is watching stays
	# empty. check-config cannot catch it either: it runs as root, and root
	# can write anywhere.
	#
	# The path comes from the program rather than from parsing TOML in sh,
	# so there is one source of truth for where the log goes.
	_logfile=$("${shim}" check-config -c "${boot_err_shim_config}" 2>/dev/null \
	    | awk '$1 == "log" && $2 == "file" { print $3 }')
	case "${_logfile}" in
	""|none)
		;;
	*)
		if [ -e "${_logfile}" ]; then
			_target="${_logfile}"
		else
			# Not there yet, so it is the directory that must allow
			# creating it.
			_target=$(dirname "${_logfile}")
		fi
		_lo=$(stat -f '%Su' "${_target}")
		_lg=$(stat -f '%Sg' "${_target}")
		_lm=$(stat -f '%Lp' "${_target}")
		_writable=no
		case "${_lm}" in
		*[2367]) _writable=yes ;;
		esac
		if [ "${_lo}" = "${boot_err_shim_user}" ]; then
			case "${_lm}" in
			[2367]*) _writable=yes ;;
			esac
		fi
		if id -Gn "${boot_err_shim_user}" 2>/dev/null | tr ' ' '\n' \
		    | grep -qx "${_lg}"; then
			case "${_lm}" in
			?[2367]*) _writable=yes ;;
			esac
		fi
		if [ "${_writable}" != yes ]; then
			err 1 "log.file ${_logfile}: ${_target} (owner ${_lo}:${_lg}," \
			    "mode ${_lm}) is not writable by ${boot_err_shim_user}," \
			    "so the daemon exits at startup and logs nothing. Run:" \
			    "touch ${_logfile} && chown ${boot_err_shim_user}" \
			    "${_logfile}"
		fi
		;;
	esac

	if [ ! -d "${boot_err_shim_state}" ]; then
		err 1 "${boot_err_shim_state} does not exist. Run:" \
		    "mkdir -p ${boot_err_shim_state} && chown" \
		    "${boot_err_shim_user} ${boot_err_shim_state}"
	fi
	_state_owner=$(stat -f '%Su' "${boot_err_shim_state}")
	if [ "${_state_owner}" != "${boot_err_shim_user}" ]; then
		err 1 "${boot_err_shim_state} is owned by ${_state_owner}," \
		    "not ${boot_err_shim_user}; the daemon could not write its" \
		    "calibration or lock file. Run: chown -R" \
		    "${boot_err_shim_user} ${boot_err_shim_state}"
	fi
}

boot_err_shim_postcmd()
{
	rm -f "${pidfile}"
	rmdir "${piddir}" 2>/dev/null || true
}

run_rc_command "$1"
